# ----------------------------
# Настройки мониторинга
# ----------------------------

# OpenTelemetry Collector
OTEL_GRPC_PORT=4317
OTEL_BATCH_SIZE=1000
OTEL_BATCH_TIMEOUT=10s
OTEL_COLLECTOR_METRICS_PORT=8889
OTEL_LOG_LEVEL=detailed

# Jaeger
JAEGER_HOST=jaeger
JAEGER_PORT=4317
JAEGER_UI_PORT=16686
