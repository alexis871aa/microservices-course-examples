# =============================================================================
# WEEK 7 METRICS - ЦЕНТРАЛИЗОВАННАЯ КОНФИГУРАЦИЯ СИСТЕМЫ МОНИТОРИНГА
# =============================================================================
#
# Этот файл содержит все переменные окружения для системы мониторинга
# Схема: UFO App -> OpenTelemetry Collector -> Prometheus -> Grafana
#
# Конфигурация оптимизирована для минимального сетапа с полной функциональностью
# Все значения подобраны для production-ready развертывания

# =============================================================================
# OPENTELEMETRY COLLECTOR - ЦЕНТРАЛЬНЫЙ АГЕНТ СБОРА ТЕЛЕМЕТРИИ
# =============================================================================
# OpenTelemetry Collector получает метрики от UFO приложения и отправляет в Prometheus

# Порты для приема телеметрических данных от приложений
CORE_OTEL_GRPC_PORT=4317 # Стандартный порт OTLP gRPC (рекомендуется)

# Настройки batch processor для оптимизации производительности
CORE_OTEL_BATCH_SIZE=1000 # Размер пакета метрик (баланс производительность/память)
CORE_OTEL_BATCH_TIMEOUT=10s # Максимальное время ожидания неполного пакета

# Порт для health check endpoint (используется Docker и системами мониторинга)
CORE_OTEL_METRICS_PORT=8889

# =============================================================================
# PROMETHEUS - БАЗА ДАННЫХ ВРЕМЕННЫХ РЯДОВ
# =============================================================================
# Prometheus хранит метрики и предоставляет их для Grafana

# Сетевые настройки Prometheus
CORE_PROMETHEUS_HOST=prometheus # Имя сервиса в Docker Compose
CORE_PROMETHEUS_PORT=9090 # Стандартный порт Prometheus

# Интервал оценки правил алертов (для будущего расширения)
CORE_PROMETHEUS_EVALUATION_INTERVAL=15s # Как часто проверять условия алертов

# =============================================================================
# GRAFANA - СИСТЕМА ВИЗУАЛИЗАЦИИ И ДАШБОРДОВ
# =============================================================================
# Grafana подключается к Prometheus и создает дашборды для мониторинга

# Сетевые настройки Grafana
CORE_GRAFANA_PORT=3000 # Стандартный порт Grafana

# Учетные данные администратора (измените в production!)
CORE_GRAFANA_ADMIN_USER=admin # Логин администратора
CORE_GRAFANA_ADMIN_PASSWORD=admin # Пароль администратора (ОБЯЗАТЕЛЬНО измените!)

# Настройки datasource для подключения к Prometheus
CORE_GRAFANA_DATASOURCE_NAME=Prometheus # Имя datasource в Grafana UI
CORE_GRAFANA_DATASOURCE_URL=http://prometheus:9090 # URL для подключения к Prometheus

# Путь к директории с JSON файлами дашбордов
CORE_GRAFANA_DASHBOARDS_PATH=/var/lib/grafana/dashboards # Путь в контейнере Grafana

# =============================================================================
# UFO SERVICE - ОСНОВНОЕ ПРИЛОЖЕНИЕ
# =============================================================================
# Настройки UFO сервиса для интеграции с системой мониторинга

# Сетевые настройки gRPC сервера
UFO_GRPC_HOST=0.0.0.0 # Слушать на всех интерфейсах
UFO_GRPC_PORT=50051 # Стандартный порт gRPC

# Настройки логирования
UFO_LOGGER_LEVEL=info # Уровень логов: debug, info, warn, error
UFO_LOGGER_AS_JSON=true # JSON формат для structured logging

# Настройки отправки метрик в OpenTelemetry Collector
UFO_METRIC_COLLECTOR_ENDPOINT=http://otel-collector:4318 # HTTP endpoint коллектора
UFO_METRIC_COLLECTOR_INTERVAL=5s # Интервал отправки метрик

# =============================================================================
# ВАЖНЫЕ ЗАМЕЧАНИЯ ПО БЕЗОПАСНОСТИ И PRODUCTION
# =============================================================================
#
# 1. ПАРОЛИ:
#    - Обязательно измените CORE_GRAFANA_ADMIN_PASSWORD в production
#    - Используйте сильные пароли (минимум 12 символов, цифры, спецсимволы)
#
# 2. ПОРТЫ:
#    - Все порты настроены по стандартам индустрии
#    - В production рекомендуется использовать reverse proxy (nginx)
#    - Не открывайте порты мониторинга в интернет напрямую
#
# 3. ПРОИЗВОДИТЕЛЬНОСТЬ:
#    - CORE_OTEL_BATCH_SIZE=1000 оптимален для большинства случаев
#    - При высокой нагрузке можно увеличить до 5000
#    - CORE_OTEL_BATCH_TIMEOUT=10s обеспечивает баланс задержки и эффективности
#
# 4. МОНИТОРИНГ:
#    - Health check доступен на http://otel-collector:13133/health
#    - Prometheus метрики доступны на http://prometheus:9090/metrics
#    - Grafana UI доступен на http://localhost:3000 (admin/admin)
#
# 5. МАСШТАБИРОВАНИЕ:
#    - Конфигурация поддерживает горизонтальное масштабирование UFO сервиса
#    - OpenTelemetry Collector можно развернуть в cluster mode
#    - Prometheus поддерживает federation для множественных инстансов
