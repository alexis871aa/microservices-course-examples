# =============================================================================
# CORE SERVICES ENVIRONMENT TEMPLATE - СИСТЕМА МОНИТОРИНГА
# =============================================================================
# Этот файл генерируется из основного .env и содержит переменные для core сервисов
# Схема: UFO App -> OpenTelemetry Collector -> Prometheus -> Grafana

# =============================================================================
# OPENTELEMETRY COLLECTOR
# =============================================================================
# Переменные для конфигурации OpenTelemetry Collector
OTEL_GRPC_PORT=4317                          # Порт OTLP gRPC
OTEL_BATCH_SIZE=1000                        # Размер пакета batch processor
OTEL_BATCH_TIMEOUT=10s                  # Таймаут batch processor
OTEL_METRICS_PORT=8889                    # Порт метрик самого коллектора

# =============================================================================
# PROMETHEUS
# =============================================================================
# Переменные для конфигурации Prometheus
PROMETHEUS_HOST=prometheus                         # Хост Prometheus
PROMETHEUS_PORT=9090                         # Порт Prometheus
PROMETHEUS_EVALUATION_INTERVAL=15s  # Интервал оценки правил

# =============================================================================
# GRAFANA
# =============================================================================
# Переменные для конфигурации Grafana
GRAFANA_PORT=3000                              # Порт Grafana
GRAFANA_ADMIN_USER=admin                  # Логин администратора
GRAFANA_ADMIN_PASSWORD=admin          # Пароль администратора
GRAFANA_DATASOURCE_NAME=Prometheus        # Имя datasource
GRAFANA_DATASOURCE_URL=http://prometheus:9090          # URL datasource
GRAFANA_DASHBOARDS_PATH=/var/lib/grafana/dashboards        # Путь к дашбордам
