# =============================================================================
# UFO SERVICE ENVIRONMENT TEMPLATE - КОНФИГУРАЦИЯ ПРИЛОЖЕНИЯ
# =============================================================================
# Этот файл генерируется из основного .env и содержит переменные для UFO сервиса
# UFO сервис отправляет метрики в OpenTelemetry Collector

# =============================================================================
# НАСТРОЙКИ gRPC СЕРВЕРА
# =============================================================================
# Конфигурация gRPC API сервера для обработки запросов клиентов

# Адрес, на котором будет слушать gRPC-сервер
# 0.0.0.0 означает "слушать на всех сетевых интерфейсах"
GRPC_HOST=0.0.0.0

# Порт, на котором будет работать gRPC-сервер
# 50051 - стандартный порт для gRPC сервисов
GRPC_PORT=50051

# =============================================================================
# НАСТРОЙКИ ЛОГИРОВАНИЯ
# =============================================================================
# Конфигурация системы логирования для отладки и мониторинга

# Уровень логирования (debug, info, warn, error)
# info - рекомендуемый уровень для production
LOGGER_LEVEL=info

# Выводить логи в формате JSON (true/false)
# JSON формат облегчает парсинг логов системами мониторинга
LOGGER_AS_JSON=true

# =============================================================================
# НАСТРОЙКИ OPENTELEMETRY МЕТРИК
# =============================================================================
# Конфигурация отправки метрик в OpenTelemetry Collector

# Адрес коллектора OpenTelemetry для отправки метрик
# Используется HTTP endpoint (порт 4318) для простоты отладки
METRIC_COLLECTOR_ENDPOINT=http://otel-collector:4318

# Интервал отправки метрик в коллектор
# 5s обеспечивает баланс между актуальностью данных и нагрузкой на систему
METRIC_COLLECTOR_INTERVAL=5s
